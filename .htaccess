# Keep internals out of the web root's public surface.
Options -Indexes

<FilesMatch "^(\.env.*|Dockerfile|render\.yaml|.*\.sqlite|.*\.sql|.*\.md)$">
    Require all denied
</FilesMatch>

RedirectMatch 404 /(model|scripts|storage|docker|database)(/|$)
RedirectMatch 404 /\.git

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
